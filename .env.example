# --- Supabase project that stores SuperDB's own data (accounts + encrypted tokens) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Canonical origin of this app, no trailing slash. Used as the OAuth return address.
# Not derived from request headers on purpose, and VERCEL_URL is the deployment URL, not the domain.
SITE_URL=http://localhost:3000

# 32 random bytes, base64. Generate with: pnpm genkey
# Losing this key means every stored access token becomes unreadable.
ENCRYPTION_KEY=

# --- Supabase OAuth app (Dashboard -> Organization settings -> OAuth Apps) ---
# Redirect URI must be exactly <SITE_URL>/api/connect/callback
SB_OAUTH_CLIENT_ID=
SB_OAUTH_CLIENT_SECRET=

# Which connection kinds this instance offers. Both by default.
CONNECT_MODES=pat,oauth
